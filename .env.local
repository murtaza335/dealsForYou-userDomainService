# User Domain Service - Local Development Configuration
# Copy this to .env for development

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# For local PostgreSQL: postgresql://username:password@localhost:5432/user_domain_db
# For Docker: postgresql://user:password@postgres:5432/user_domain_db
# For Supabase: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_domain_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/user_domain_db

# JWT & Internal Token Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-development-secret-key-change-in-production

# Token expiry time in minutes
TOKEN_EXPIRY_MINUTES=15

# Clerk Configuration
# Get these from your Clerk dashboard: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_test_secret_here
CLERK_JWKS_URL=https://your-instance.clerk.com/.well-known/jwks.json

# Service Configuration
SERVICE_NAME=user-domain-service
